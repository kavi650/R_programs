# Program 3: Decomposing Non-Seasonal Data

n <- c(55, 42, 36, 40, 50, 22, 36, 82, 44)

n.sma <- stats::filter(n, rep(1/3, 3), sides = 2)

plot(n, type = "o", col = "black", pch = 16,
     xlab = "Time", ylab = "Value",
     main = "Original Data vs 3-Year Moving Average")

lines(n.sma, col = "red", lwd = 2, type = "o", pch = 16)

legend("topright",
       legend = c("Original", "Moving Avg"),
       col = c("black", "red"),
       lty = 1,
       pch = 16)
