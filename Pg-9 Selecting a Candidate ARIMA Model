# Program 9: Selecting a Candidate ARIMA Model

sales <- c(120, 125, 132, 140, 151, 160, 172, 185, 197, 210)

sales.ts <- ts(sales, start = 2015, frequency = 1)

plot(sales.ts,
     type = "o",
     col = "blue",
     lwd = 2,
     main = "Original Time Series",
     xlab = "Year",
     ylab = "Sales")

sales.diff <- diff(sales.ts)

plot(sales.diff,
     type = "o",
     col = "red",
     lwd = 2,
     main = "First-order Differenced Series",
     xlab = "Year",
     ylab = "Differenced Sales")

acf(sales.diff, main = "ACF of Differenced Series")

pacf(sales.diff, main = "PACF of Differenced Series")

install.packages("forecast")
library(forecast)

fit <- Arima(sales.ts, order = c(0, 1, 1))

summary(fit)

forecast.values <- forecast(fit, h = 5)

forecast.values

plot(forecast.values,
     main = "ARIMA(0,1,1) Forecast")
