# Program 5: Decomposing Seasonally Adjusted Time Series

sales <- c(
  120, 130, 150, 180, 210, 250, 270, 260, 220, 190, 160, 140,
  130, 140, 165, 195, 225, 265, 285, 275, 235, 205, 175, 150
)

# Create time series object
sales.ts <- ts(sales, start = c(2023, 1), frequency = 12)

# Display the time series
sales.ts

# Plot the original time series
plot(sales.ts,
     type = "o",
     pch = 16,
     col = "blue",
     lwd = 2,
     main = "Original Monthly Sales",
     xlab = "Year",
     ylab = "Sales (₹ thousand)")

grid()

# Perform additive decomposition
sales.decomp <- decompose(sales.ts, type = "additive")

# Display decomposition
sales.decomp

# Plot decomposition
plot(sales.decomp)

# Obtain seasonally adjusted series
sales.adjusted <- sales.ts - sales.decomp$seasonal

# Display adjusted values
sales.adjusted

# Plot seasonally adjusted series
plot(sales.adjusted,
     type = "o",
     pch = 16,
     col = "red",
     lwd = 2,
     main = "Seasonally Adjusted Sales",
     xlab = "Year",
     ylab = "Adjusted Sales")

grid()

# Compare original and adjusted series
plot(sales.ts,
     type = "o",
     pch = 16,
     col = "blue",
     lwd = 2,
     main = "Original vs Seasonally Adjusted Sales",
     xlab = "Year",
     ylab = "Sales")

lines(sales.adjusted,
      type = "o",
      pch = 16,
      col = "red",
      lwd = 2)

legend("topleft",
       legend = c("Original", "Seasonally Adjusted"),
       col = c("blue", "red"),
       lty = 1,
       pch = 16)

grid()
