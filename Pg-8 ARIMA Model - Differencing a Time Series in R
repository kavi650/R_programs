# Program 8: ARIMA Model - Differencing a Time Series in R

sales <- c(120, 125, 132, 140, 151, 160, 172, 185)

sales.ts <- ts(sales, start = 2016, frequency = 1)

sales.ts

diff.sales <- diff(sales.ts, differences = 1)

diff.sales

plot(sales.ts,
     type = "o",
     col = "blue",
     lwd = 2,
     xlab = "Year",
     ylab = "Sales",
     main = "Original Time Series")

plot(diff.sales,
     type = "o",
     col = "red",
     lwd = 2,
     xlab = "Year",
     ylab = "First Difference",
     main = "First-Order Differenced Series")

diff2.sales <- diff(sales.ts, differences = 2)

diff2.sales

plot(diff2.sales,
     type = "o",
     col = "darkgreen",
     lwd = 2,
     xlab = "Year",
     ylab = "Second Difference",
     main = "Second-Order Differenced Series")
